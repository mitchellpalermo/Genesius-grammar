#gtable(columns: 3, [#emph[Sing];. 1. c. #emph[my.];], [#he[י];], [#he[־ִי];], [2. m. #emph[thy.];], [#he[ךָ];], [#he[־ְךָ]; (#emph[pause]; #he[־ֶ֫ ךָ];)], [f.], [#he[ךְ];], [#he[־ֵךְ];], [3. m. #emph[his.];], [#he[הוּ];, #he[ו];], [#he[וֹ]; (#he[הֹ];), #he[־ֵ֫ הוּ];], [f. #emph[her.];], [#he[הָ];], [#he[־ָהּ];, #he[־ֶ֫ הָ];]);

];

