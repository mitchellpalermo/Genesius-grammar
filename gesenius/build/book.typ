he[חָמֵשׁ];], [#he[חֲמֵשׁ];], [6], [#he[שִׁשָּׁה];], [#he[שֵׁ֫שֶׁת];], [#he[שֵׁשׁ];], [#he[שֵׁשׁ];], [7.], [#he[שִׁבְעָה];], [#he[שִׁבְעַת];], [#he[שֶׁ֫בַע];], [#footnote[#he[שְׁבַע]; and #he[תְּשַׁע]; appear only as connective forms before #he[עֶשְׂרֵה]; and #he[מֵאוֹת];.];#he[\[שְׁבַע\]];], [8.], [#he[שְׁמֹנָה];], [#he[שְׁמֹנַת];], [#he[שְׁמֹנֶה];], [#he[שְׁמֹנֶה];], [9.], [#he[תִּשְׁעָה];], [#he[תִּשְׁעַת];], [#he[תֵּ֫שַׁע];], [#super[\[3\]];#he[\[תְּשַׁע\]];], [10.], [#he[עֲשָׂרָה];], [#he[עֲשֶׂ֫רֶת];], [#he[עֶ֫שֶׂר];], [#he[עֶ֫שֶׂר];]);

